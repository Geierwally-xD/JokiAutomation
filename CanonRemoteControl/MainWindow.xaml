<Window x:Class="CanonRemoteControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canon CRN-100 Remote Control [AKTIV]" 
        Height="300" 
        Width="500"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        Topmost="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FF2C2C2C">
        <StackPanel Margin="20">
            <TextBlock Text="Canon CRN-100 Fernsteuerung" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Foreground="White"
                       Margin="0,0,0,15"/>

            <Border Background="#FF1E1E1E" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="STATUS: AKTIV" 
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="LimeGreen"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Tastaturkuerzel sind aktiv!" 
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Sie koennen dieses Fenster minimieren." 
                               Foreground="LightGray"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Druecken Sie Ctrl+Shift+H fuer Hilfe" 
                               Foreground="LightBlue"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Statusmeldungen erscheinen oben rechts" 
                               Foreground="LightGray"
                               FontStyle="Italic"
                               Margin="0,0,0,5"/>
                </StackPanel>
            </Border>

            <Button Content="Tastaturkuerzel-Hilfe anzeigen" 
                    Click="ShowHelp_Click" 
                    Width="200" 
                    Height="35" 
                    FontSize="14"
                    Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
