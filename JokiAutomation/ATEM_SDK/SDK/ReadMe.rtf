\fs22 \cf0 \
	- New Interfaces\
\
		- IBMDSwitcherUSBPort\

\f1\b0 			The 
\f0\b IBMDSwitcherUSBPort
\f1\b0  interface contains functionality to manage USB port function configuration (webcam or USB audio).\

\f0\b \
		- IBMDSwitcherUSBPortCallback\

\f1\b0 			Used for notifications regarding any changes to 
\f0\b IBMDSwitcherUSBPort
\f1\b0 .\

\f0\b \
		- IBMDSwitcherUSBPortIterator\

\f1\b0 			Used to iterate through 
\f0\b IBMDSwitcherUSBPort
\f1\b0  objects.\

\f0\b \
		- IBMDSwitcherCloudStreamDestination\

\f1\b0 			The 
\f0\b IBMDSwitcherCloudStreamDestination
\f1\b0  interface describes a Blackmagic Cloud Stream Router destination which can be configured as a streaming destination.\

\f0\b \
		- IBMDSwitcherCloudStreamDestinationCallback\

\f1\b0 			Used for notifications regarding any changes to 
\f0\b IBMDSwitcherCloudStreamDestination
\f1\b0 .\

\f0\b \
		- IBMDSwitcherCloudStreamDestinationIterator\

\f1\b0 			Used to iterate through 
\f0\b IBMDSwitcherCloudStreamDestination
\f1\b0  objects.\

\f0\b \
		- IBMDSwitcherRemoteSourceCloud\

\f1\b0 			The 
\f0\b IBMDSwitcherRemoteSourceCloud
\f1\b0  interface provides functionality to manage Blackmagic Cloud remote sources.\

\f0\b \
		- IBMDSwitcherRemoteSourceCloudCallback\

\f1\b0 			Used for notifications regarding any changes to 
\f0\b IBMDSwitcherRemoteSourceCloud
\f1\b0 .\

