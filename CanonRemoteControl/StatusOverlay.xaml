<Window x:Class="CanonRemoteControl.StatusOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canon Status" 
        SizeToContent="WidthAndHeight"
        MaxWidth="500"
        WindowStyle="ToolWindow"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Left="100"
        Top="100">
    <Border x:Name="StatusBorder"
            BorderBrush="Green"
            BorderThickness="5"
            Padding="20">
        <TextBlock x:Name="StatusText" 
                   Text="TEST - StatusOverlay ist sichtbar!" 
                   Foreground="White" 
                   FontSize="18" 
                   FontWeight="Bold"
                   TextWrapping="Wrap"/>
    </Border>
</Window>
